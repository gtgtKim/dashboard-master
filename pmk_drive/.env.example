BASE_PATH=/pmk_drive
APP_URL=http://127.0.0.1:8090/pmk_drive
DATA_DIR=data
PMK_ADMIN_USERNAME=admin
# Set before first startup. The bootstrap value is read only when the database is first created.
PMK_ADMIN_PASSWORD=
STORAGE_BACKEND=local
# local | gcs | s3. Do not switch a populated installation without migrating objects.
GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ADDRESSING_STYLE=auto
AWS_DEFAULT_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 100 GiB per file. Upload chunks are streamed or sent directly to cloud storage.
MAX_FILE_SIZE=107374182400
